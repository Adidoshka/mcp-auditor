{
  "name": "mcp-auditor",
  "version": "0.1.0",
  "private": true,
  "description": "Audits an MCP server's exposed tools for risks to the agent connecting to it.",
  "type": "module",
  "scripts": {
    "target-server": "tsx target-server/server.ts",
    "eval": "tsx eval/run.ts",
    "audit": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p ."
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.15.0",
    "undici": "^8.10.2",
    "zod": "^4.6.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
