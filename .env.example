# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Used by src/llm/classify.ts (new OpenAI({ apiKey: ... }) is pointed at
# this explicitly — NVIDIA NIM's OpenAI-compatible endpoint, not OpenAI's
# own API, so this is NOT the same key as OPENAI_API_KEY would be).
NVIDIA_API_KEY=
